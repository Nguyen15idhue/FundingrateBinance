# ============================================================
#  FUNDING HARVEST — MẪU BIẾN MÔI TRƯỜNG
#  Sao chép thành .env rồi điền giá trị thật.
# ============================================================

# ---------- BINANCE API (LIVE) ----------
BINANCE_API_KEY=your_live_trade_key
BINANCE_API_SECRET=your_live_trade_secret

BINANCE_READONLY_KEY=your_readonly_key
BINANCE_READONLY_SECRET=your_readonly_secret

# ---------- BINANCE DEMO TRADING (ví ảo, không phải tiền thật) ----------
# Tạo key tại https://demo.binance.com/en/my/settings/api-management
# Endpoint tự chọn: demo-api.binance.com (Spot) / demo-fapi.binance.com (Futures)
BINANCE_DEMO_API_KEY=your_demo_trade_key
BINANCE_DEMO_API_SECRET=your_demo_trade_secret
# Tuỳ chọn: key chỉ đọc riêng trong demo cho monitor/reconcile
BINANCE_DEMO_READONLY_KEY=
BINANCE_DEMO_READONLY_SECRET=
BINANCE_USE_DEMO=false

# ---------- CẤU HÌNH API ----------
# Để trống = tự chọn live/demo theo BINANCE_USE_DEMO. Chỉ điền khi cần override.
BINANCE_SPOT_BASE_URL=
BINANCE_FUTURES_BASE_URL=
BINANCE_RECV_WINDOW=5000
BINANCE_TIMEOUT_SECONDS=15

# ---------- AN TOÀN ----------
LIVE_TRADING_ENABLED=false
DRY_RUN=true
KILL_SWITCH_ENABLED=true
MAX_ORDER_NOTIONAL_USD=125

# ---------- VỐN ----------
CAPITAL_TOTAL_USD=500
CAPITAL_SPOT_USD=235
CAPITAL_FUTURES_USD=265
PERP_LEVERAGE=1
MAX_COINS=3

# ---------- ALERT ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
DEADMAN_PING_URL=

# ---------- DỮ LIỆU & LOG ----------
DATABASE_URL=sqlite:///data/funding.db
LOG_LEVEL=INFO
TZ=UTC
SCREENER_MAX_SYMBOLS=120


